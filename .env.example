# Environment Variables Template
# Salin file ini menjadi `.env` atau `.env.local` lalu isi dengan kredensial Anda.
# PENTING: Jangan masukkan password atau kredensial produksi asli ke dalam repository!

# ============================================================
# DATABASE POSTGRESQL (Lokal / Non-Docker)
# Format URL Koneksi PostgreSQL:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_reference_validator?schema=public"

# ============================================================
# DOCKER COMPOSE CONFIGURATION (Opsional - Sudah ada default)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_reference_validator
POSTGRES_PORT=5432
APP_PORT=3000
# Set 'true' untuk mengisi mock data (user: budi@nexustrace.com / password123) secara otomatis
SEED_ON_START=true

# ============================================================
# CLOUDFLARE TURNSTILE (CAPTCHA & DDOS / BOT SHIELD)
# Dapatkan keys resmi di: https://dash.cloudflare.com/?to=/:account/turnstile
# Default di bawah ini adalah Test Keys resmi Cloudflare (Selalu Lolos)
# ============================================================
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ============================================================
# ACCURATE ONLINE (AOL) API INTEGRATION
# Dokumentasi: https://accurate.id/api-integration/api-example/
# ============================================================
# Access Token didapatkan melalui proses OAuth Accurate Online Developer
ACCURATE_ACCESS_TOKEN="your-accurate-access-token"

# ID Database Accurate Online (didapat dari GET /api/db-list.do)
ACCURATE_DB_ID="your-database-id"

# (Opsional) Host API default Accurate Online jika tidak diisi akan otomatis terdeteksi via open-db.do
ACCURATE_API_HOST="https://public.accurate.id"