generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  BOM
  PR
  PO
  GR
  PI
  PP
  INVOICE
  PURCHASE_RETURN
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VOID
  ARCHIVED
}

enum ValidationStatus {
  VALID
  INVALID
  WARNING
  FAILED
  PENDING
  SKIPPED
}

model Document {
  id                String             @id @default(cuid())
  documentType      DocumentType
  documentNumber    String             @unique
  referenceNumber   String?
  documentDate      DateTime
  vendor            String?
  amount            Decimal            @db.Decimal(15, 2)
  currency           String             @default("IDR")
  exchangeRate       Decimal            @default(1) @db.Decimal(15, 6)
  baseCurrencyAmount Decimal?           @db.Decimal(15, 2)
  quantity           Decimal?           @db.Decimal(15, 2)
  batchQuantity      Decimal?           @db.Decimal(15, 2)
  taxAmount          Decimal?           @default(0) @db.Decimal(15, 2)
  taxRate            Decimal?           @default(0) @db.Decimal(5, 2)
  withholdingTax     Decimal?           @default(0) @db.Decimal(15, 2)
  withholdingTaxRate Decimal?           @default(0) @db.Decimal(5, 2)
  isTaxInclusive     Boolean            @default(false)
  discountAmount     Decimal?           @default(0) @db.Decimal(15, 2)
  externalSystem     String?
  externalId         String?
  externalUpdatedAt  DateTime?
  description       String?
  notes             String?
  status            DocumentStatus     @default(DRAFT)
  validationStatus  ValidationStatus   @default(PENDING)
  references        DocumentRelation[] @relation("SourceDocument")
  referencedBy      DocumentRelation[] @relation("TargetDocument")
  items             DocumentItem[]
  auditLogs         AuditLog[]
  syncHistory       SyncHistory[]
  validationResults ValidationResult[]
  approvalTasks     ApprovalTask[]
  voidedAt          DateTime?
  voidedBy          String?
  voidReason        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  
  @@unique([documentType, documentNumber])
  @@unique([externalSystem, externalId])
  @@index([documentType])
  @@index([validationStatus])
  @@index([createdAt])
  @@map("document")
}

model DocumentRelation {
  id                String           @id @default(cuid())
  sourceDocumentId  String
  sourceDocument    Document         @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId  String
  targetDocument    Document         @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  relationDate      DateTime         @default(now())
  itemCount         Int              @default(1)
  amount            Decimal          @default(0) @db.Decimal(15, 2)
  quantityRatio     Decimal?         @db.Decimal(10, 4)
  quantityOrdered   Decimal?         @db.Decimal(15, 2)
  quantityReceived  Decimal?         @db.Decimal(15, 2)
  validationStatus  ValidationStatus @default(PENDING)
  discrepancy       String?          @db.Text
  failureReason     String?          @db.Text
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@unique([sourceDocumentId, targetDocumentId])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@index([validationStatus])
  @@map("documentRelation")
}

model DocumentItem {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  quantity        Decimal  @db.Decimal(15, 2)
  unitPrice       Decimal  @default(0) @db.Decimal(15, 2)
  totalPrice      Decimal  @default(0) @db.Decimal(15, 2)
  uom             String?  @default("PCS")
  bomRatio        Decimal? @db.Decimal(10, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([documentId])
  @@index([itemCode])
  @@map("documentItem")
}

model ValidationResult {
  id                String   @id @default(cuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ruleName          String
  ruleDescription   String?
  passed            Boolean
  message           String?
  details           String?
  severity          String   @default("WARNING")
  createdAt         DateTime @default(now())
  
  @@index([documentId])
  @@index([passed])
  @@map("validationResult")
}

model AuditLog {
  id                String    @id @default(cuid())
  documentId        String?
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  entityType        String    @default("DOCUMENT")
  entityId          String?
  action            String
  performedBy       String
  actorUserId       String?
  oldValues         Json?
  newValues         Json?
  ipAddress         String?
  details           String?
  createdAt         DateTime  @default(now())
  
  @@index([documentId])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("auditLog")
}

model SyncHistory {
  id                String    @id @default(cuid())
  documentId        String?
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  syncType          String
  status            String
  recordsProcessed  Int       @default(0)
  recordsSuccessful Int       @default(0)
  recordsFailed     Int       @default(0)
  errorLog          String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("syncHistory")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  password          String?
  name              String?
  image             String?       @db.Text
  role              String        @default("USER")
  active            Boolean       @default(true)
  twoFactorEnabled  Boolean       @default(true)
  twoFactorSecret   String?
  backupCodes       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          UserSession[]

  @@map("user")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  device       String
  browser      String
  os           String
  ipAddress    String
  location     String
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@map("userSession")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalRule {
  id           String         @id @default(cuid())
  name         String
  documentType DocumentType
  minAmount    Decimal        @default(0) @db.Decimal(15, 2)
  maxAmount    Decimal?       @db.Decimal(15, 2)
  requiredRole String
  stepOrder    Int            @default(1)
  isActive     Boolean        @default(true)
  tasks        ApprovalTask[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([documentType, isActive])
  @@map("approvalRule")
}

model ApprovalTask {
  id              String         @id @default(cuid())
  documentId      String
  document        Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            ApprovalRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  stepOrder       Int            @default(1)
  assignedRole    String
  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?
  decidedByName   String?
  comment         String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([documentId, stepOrder])
  @@index([assignedRole, status])
  @@map("approvalTask")
}

model ValidationTolerance {
  id                      String   @id @default(cuid())
  name                    String   @unique
  category                String   @default("GLOBAL")
  qtyTolerancePercent     Decimal  @default(0) @db.Decimal(6, 2)
  priceTolerancePercent   Decimal  @default(0) @db.Decimal(6, 2)
  amountToleranceAbsolute Decimal  @default(0) @db.Decimal(15, 2)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([category, isActive])
  @@map("validationTolerance")
}
