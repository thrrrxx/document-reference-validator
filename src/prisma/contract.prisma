// use prisma-8

enum DocumentType {
  @@type("pg/text@1")
  BOM = "BOM"
  PR = "PR"
  PO = "PO"
  GR = "GR"
  INVOICE = "INVOICE"
}

enum DocumentStatus {
  @@type("pg/text@1")
  DRAFT = "DRAFT"
  SUBMITTED = "SUBMITTED"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
  ARCHIVED = "ARCHIVED"
}

enum ValidationStatus {
  @@type("pg/text@1")
  VALID = "VALID"
  FAILED = "FAILED"
  PENDING = "PENDING"
  SKIPPED = "SKIPPED"
}

model Document {
  id                String              @id @default(uuid())
  documentType      DocumentType
  documentNumber    String              @unique
  referenceNumber   String?
  documentDate      TimestamptzString
  vendor            String?
  amount            Decimal
  currency          String              @default("IDR")
  description       String?
  notes             String?
  status            DocumentStatus      @default(DRAFT)
  validationStatus  ValidationStatus    @default(PENDING)
  references        DocumentReference[] @relation("SourceDocument")
  referencedBy      DocumentReference[] @relation("TargetDocument")
  auditLogs         AuditLog[]
  syncHistory       SyncHistory[]
  validationResults ValidationResult[]
  createdAt         TimestamptzString   @default(now())
  updatedAt         temporal.updatedAtString()
  createdBy         String?

  @@unique([documentType, documentNumber])
  @@index([documentType])
  @@index([validationStatus])
  @@index([createdAt])
}

model DocumentReference {
  id               String            @id @default(uuid())
  sourceDocumentId String
  sourceDocument   Document          @relation("SourceDocument", fields: [sourceDocumentId], references: [id])
  targetDocumentId String
  targetDocument   Document          @relation("TargetDocument", fields: [targetDocumentId], references: [id])
  referenceDate    TimestamptzString @default(now())
  itemCount        Int               @default(1)
  amount           Decimal
  validationStatus ValidationStatus  @default(PENDING)
  failureReason    String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([sourceDocumentId, targetDocumentId])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
}

model ValidationResult {
  id              String            @id @default(uuid())
  documentId      String
  document        Document          @relation(fields: [documentId], references: [id])
  ruleName        String
  ruleDescription String?
  passed          Boolean
  message         String?
  details         String?
  severity        String            @default("WARNING")
  createdAt       TimestamptzString @default(now())

  @@index([documentId])
  @@index([passed])
}

model AuditLog {
  id          String            @id @default(uuid())
  documentId  String
  document    Document          @relation(fields: [documentId], references: [id])
  action      String
  performedBy String
  details     String?
  createdAt   TimestamptzString @default(now())

  @@index([documentId])
  @@index([createdAt])
}

model SyncHistory {
  id                String             @id @default(uuid())
  documentId        String?
  document          Document?          @relation(fields: [documentId], references: [id])
  syncType          String
  status            String
  recordsProcessed  Int                @default(0)
  recordsSuccessful Int                @default(0)
  recordsFailed     Int                @default(0)
  errorLog          String?
  startedAt         TimestamptzString  @default(now())
  completedAt       TimestamptzString?

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

model User {
  id        String            @id @default(uuid())
  email     String            @unique
  password  String?
  name      String?
  role      String            @default("USER")
  active    Boolean           @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
